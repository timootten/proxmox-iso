# Defaults for the ISO build. Workflow inputs (manual run) override these values.
# Format: KEY=VALUE, one per line, no spaces around "=".

# vps = virtual server on one disk (ext4 + LVM, one global storage "local")
# baremetal = physical server (ZFS, storage "local-zfs" for VMs)
TARGET=vps

FQDN=pve.timootten.com
MAILTO=hi@timootten.com
COUNTRY=de
KEYBOARD=de
TIMEZONE=Europe/Berlin

# dhcp or static. static needs IP_CIDR and GATEWAY, for example 5.175.223.10/24 and 5.175.223.1
NETWORK_MODE=dhcp
IP_CIDR=
GATEWAY=

# Order matters. Linux resolvers use at most three entries, so the fourth one is only kept as a note.
DNS_SERVERS="1.1.1.1 8.8.8.8 2606:4700:4700::1111 2001:4860:4860::8888"

# Disks for the installation. vps: sda. baremetal example: "nvme0n1 nvme1n1"
DISK_LIST=sda
# baremetal only: raid0, raid1, raid10, raidz-1, raidz-2, raidz-3
ZFS_RAID=raid1
# baremetal only: limit the ZFS read cache in GiB (empty = ZFS default, half of the RAM)
ZFS_ARC_MAX_GIB=
# vps only
SWAP_GIB=4

# net.ipv4.ip_forward and IPv6 forwarding: true, false or auto (true when routes or interface snippets exist)
IP_FORWARDING=auto

# Automatic updates: security = Debian security updates are installed automatically (no reboot), none = off.
# Proxmox packages and kernels are never touched automatically.
HOST_AUTO_UPDATE=security

# Optional host firewall: only these addresses may reach SSH (22) and the web interface (8006).
# Space separated CIDRs. Empty = firewall stays off. A wrong value locks you out.
MGMT_ALLOWED=

# VM templates built on the first boot. The generator lives in templates/ of this repository.
# TEMPLATE_LANG: de or en (locale, keyboard, timezone of the templates)
# TEMPLATE_SET: none, minimal (Debian 13), standard (see templates/sets.env) or all
# TEMPLATES: extra names on top of the set, relative to templates/configs/<lang>/, space separated
# TEMPLATE_AUTO_REFRESH: true = a monthly timer rebuilds the templates from the current cloud images
TEMPLATE_AUTO_REFRESH=true
TEMPLATE_LANG=de
TEMPLATE_SET=minimal
TEMPLATES=

# Branding of the template MOTD (the banner is templates/motd.sh). Links are optional and hidden when empty.
BRAND_DOCS_URL=
BRAND_SUPPORT_URL=
