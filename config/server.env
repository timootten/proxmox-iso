# Settings for the ISO build. The ISO is only built by a manual run of "Build Proxmox ISO".
# The form takes precedence, empty fields fall back to this file.
# Format: KEY=VALUE, one per line, no spaces around "=".

# vps = virtual server on one disk (ext4 + LVM, one global storage "local")
# baremetal = physical server (ZFS, storage "local-zfs" for VMs)
TARGET=vps

FQDN=hydrogen.timootten.com
MAILTO=hi@timootten.com
COUNTRY=de
KEYBOARD=de
TIMEZONE=Europe/Berlin

# Network of the server (always static). IPv4 and IPv6 are both optional, one of them is required.
# Normally you enter them in the form of the manual run instead.
IP_CIDR=
GATEWAY=
# Optional IPv6. Both or none. Routed /64 with a gateway outside of the prefix: keep IPV6_GATEWAY_ONLINK=true
IPV6_CIDR=
IPV6_GATEWAY=
IPV6_GATEWAY_ONLINK=true

# Private network for VMs: bridge vmbr1 (vmbr0 is the public uplink with the host address).
# Source NAT lets the VMs reach the internet, dnsmasq gives them an address (DHCP range .100 to .200) and DNS.
PRIVATE_NET=true
PRIVATE_NET_CIDR=10.10.0.1/24
PRIVATE_NET_NAT=true
PRIVATE_NET_DHCP=true

# Resolvers, in this order. Linux uses at most three, the fourth is only kept as a note.
DNS_SERVERS="1.1.1.1 8.8.8.8 2606:4700:4700::1111 2001:4860:4860::8888"

# Disks for the installation. vps: sda. baremetal example: "nvme0n1 nvme1n1"
DISK_LIST=sda
# baremetal only: raid0, raid1, raid10, raidz-1, raidz-2, raidz-3
ZFS_RAID=raid1
# baremetal only: limit the ZFS read cache in GiB (empty = ZFS default, half of the RAM)
ZFS_ARC_MAX_GIB=
# vps only
SWAP_GIB=4
# vps only: size of the root volume during the installation. A small volume makes "Creating root file system"
# much faster on network storage. The first boot grows it to the whole disk.
ROOT_INSTALL_GIB=20

# System: install all updates on the first boot (apt update + dist-upgrade) and these tools.
# On a VPS qemu-guest-agent is added, on bare metal the CPU microcode (when the repository has it).
SYSTEM_UPGRADE=true
HOST_PACKAGES="curl wget fastfetch iperf3 btop htop"
# default = the kernel Proxmox recommends (after the upgrade already newer than the one on the ISO)
# latest  = the newest opt-in kernel Proxmox offers (newer, but not yet the recommended default)
KERNEL=default
# Reboot once after the first boot when a newer kernel than the running one was installed.
# Older kernels stay installed as a fallback.
REBOOT_AFTER_UPGRADE=true

# Security hardening: SSH limits, kernel network settings, fail2ban for SSH and the web interface,
# rpcbind off (only needed for NFSv3), local-only mail
HARDENING=true
# Debian security updates install themselves (no automatic reboot): security or none.
# Proxmox packages and kernels are never touched automatically.
HOST_AUTO_UPDATE=security
# hide = remove the "No valid subscription" pop-up of the web interface (re-applied after updates), keep = leave it
SUBSCRIPTION_NAG=hide

# net.ipv4.ip_forward and IPv6 forwarding: true, false or auto (true when the private network, routes or snippets exist)
IP_FORWARDING=auto

# Optional host firewall: only these addresses may reach SSH (22) and the web interface (8006).
# Space separated CIDRs. Empty = firewall stays off. A wrong value locks you out.
MGMT_ALLOWED=

# VM templates built on the first boot. The generator lives in templates/ of this repository.
# TEMPLATE_SET: none, minimal (Debian 13), standard (see templates/sets.env) or all
# TEMPLATES: extra names on top of the set, relative to templates/configs/<lang>/, space separated
# TEMPLATE_AUTO_REFRESH: true = a monthly timer rebuilds the templates from the current cloud images
# TEMPLATE_LANG: de or en (locale, keyboard, timezone of the templates)
TEMPLATE_SET=minimal
TEMPLATES=
TEMPLATE_AUTO_REFRESH=true
TEMPLATE_LANG=de

# Branding of the template MOTD (the banner is templates/motd.sh). Links are optional and hidden when empty.
BRAND_DOCS_URL=
BRAND_SUPPORT_URL=
